rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // Chat images
    match /chat-images/{leadId}/{fileName} {
      // Allow authenticated users to upload images (max 5MB)
      allow create: if isAuthenticated() 
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      
      // Allow authenticated users to read images
      allow read: if isAuthenticated();
      
      // Don't allow updates or deletes
      allow update, delete: if false;
    }

    // Voice messages
    match /voice-messages/{leadId}/{fileName} {
      // Allow authenticated users to upload voice messages
      allow create: if isAuthenticated();
      
      // Allow authenticated users to read voice messages
      allow read: if isAuthenticated();
      
      // Don't allow updates or deletes
      allow update, delete: if false;
    }
    
    // Lead attachments (existing or future)
    match /lead-attachments/{leadId}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
  }
}
